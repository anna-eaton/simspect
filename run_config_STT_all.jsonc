// STT_all — 8 interleave variants per Alloy instance (v0=0 chains, v1..v7
// random 1 or 2 chains), both branch modes, fnc-commit stall = 150 cycles.
// XML phase reuses testsets/STT_6/xml (symlinked at testsets/STT_all/xml).
// This is the recon-modded driver; sttbuild + amulet watchers consume the
// same testset and write to STT_all_sttbuild / STT_all_amulet.
{
  "paths": {
    "alloy_stage":        "STAGE1_alloy",
    "models_dir":         "STAGE1_alloy/models",
    "stage2_dir":         "STAGE2_compilation",
    "instruction_tables": "STAGE2_compilation/instruction_tables/instructions.jsonc",
    "stage3_dir":         "STAGE3_gem5",
    "testset_dir":        "testsets",
    "results_dir":        "results",
    "results_name":       "STT_all_recon"
  },

  "alloy": {
    "max_instances": 250000,
    "batch_size":    1000
  },

  "speculation": {
    "control_flow": true,
    "data_flow":    false,
    "branch_modes": ["mispredict_not_taken", "mispredict_taken"]
  },

  "gem5": {
    "binary":                  "/work/gem5-recon-modded/build/X86/gem5.opt",
    "config_script":           "/work/gem5-recon-modded/configs/example/se.py",
    "branch_ann_enable":       true,
    "cpu_type":                "X86O3CPU",
    "scheme":                  2,
    "caches":                  true,
    "jobs":                    16,
    "debug_flags":             ["O3PipeView"],
    "debug_file":              "pipeview.txt",
    "fnc_commit_stall_cycles": 150,
    "sample_fraction":         0.25
  },

  "sweep": {
    "enabled":                 true,
    "points":                  [0, 500, 2500],
    "unresolved_stall_cycles": 5000
  },

  "pipeline": {
    "check":    "per_type",
    "keep_tmp": false
  },

  "interleave": {
    "enabled":               true,
    "variants_per_instance": 8,
    "variant_zero_no_chain": true,
    "num_chains_choices":    [1, 2],
    "free_pool": {
      "reg": 5,
      "mem": 3
    },
    "chain": {
      "min_length": 2,
      "max_length": 4,
      "step_kinds": ["other_n", "ld", "str"]
    },
    "num_chains": 1
  }
}
