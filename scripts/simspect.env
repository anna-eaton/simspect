# simspect session config — sourced by scripts/sim.
# Edit hostnames/sizes here; nothing else hardcodes them.

# ── Compute node (Slurm + docker live here) ───────────────────────────────────
CAFE_HOST=cafe2                 # ssh alias in ~/.ssh/config (ProxyJump sc)
SC_HOST=sc                      # Slurm login node (we run squeue/sbatch here)
SLURM_ACCOUNT=cafe
SLURM_PART=cafe-interactive
SLURM_MEM=32G
SLURM_TIME=2-00:00:00           # holder job max life; re-run `make hold` to renew
HOLD_JOBNAME=hold_simspect      # the detached sleep-infinity job that owns the node

# ── Docker container on the node ──────────────────────────────────────────────
CONTAINER=gem5_dev
CONTAINER_IP=172.17.0.2         # docker bridge IP (used for the dashboard port-forward)
REPO_IN_CONTAINER=/tests/simspect
TMUX_WORK=work                  # persistent work session inside the container
TMUX_DASH=dash                  # dashboard runs in its own session inside the container
DASH_PORT=8765

# ── Always-on driver: the Mac mini (Tailscale) ───────────────────────────────
MINI_HOST=annas-mac-mini.taila6e9af.ts.net
MINI_USER=annaeaton
MINI_TMUX=simspect              # persistent driver session on the mini
MINI_REPO=~/simspect            # where the driver-harness clone lives on the mini (make mini-clone)

# ── git sync ──────────────────────────────────────────────────────────────────
GIT_REMOTE=origin
GIT_BRANCH=main
