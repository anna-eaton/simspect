-- util/ordering[Instruction] as IOrd  -- Alloy 6: pre-binding fails in complex models

/*********************************************************************************
 * §1 Vocabulary
 */

one sig rBool {} // resolved                                    -- [sk-1]
one sig cBool {} // committed                                   -- [sk-1]
one sig tBool {} // transmitter - if flagged this is the bad spec transmitter  -- [sk-1]

// state sigs
abstract sig State {}
sig Mem_s extends State {}
sig Reg_s extends State {}

// instruction kind tags (one sig = exactly one atom each)
abstract sig InstrType {}
one sig TLoad    extends InstrType {} // load from memory
one sig TStore   extends InstrType {} // store to memory
one sig TBranchn extends InstrType {} // ctrl/br op, doesnt xmit
one sig TBranchx extends InstrType {} // ctrl/br op, xmits
one sig TOthern  extends InstrType {} // ALU/reg->reg, doesnt xmit
one sig TOtherx  extends InstrType {} // ALU/reg->reg, xmits

//@@N-BEGIN ix-atoms (regenerated by derive_core_u.py resize --max-instr N)
// fixed position atoms for symmetry-breaking index (one sig = no atom permutation)
one sig IX0 {} -- spo position 0 (first)
one sig IX1 {} -- spo position 1
one sig IX2 {} -- spo position 2
one sig IX3 {} -- spo position 3
one sig IX4 {} -- spo position 4
one sig IX5 {} -- spo position 5
fun IXs : univ { IX0 + IX1 + IX2 + IX3 + IX4 + IX5 }                          -- [sk-2]
fun ix_next : univ -> univ { IX0->IX1 + IX1->IX2 + IX2->IX3 + IX3->IX4 + IX4->IX5 }  -- [sk-2]
//@@N-END ix-atoms

// single concrete instruction sig
sig Instruction {
	kind: one InstrType,
	idx: one (IX0 + IX1 + IX2 + IX3 + IX4 + IX5),  -- spo rank (prefix of the IX atoms, [sk-2])

	spo: lone Instruction,

	// state elements define what goes in and out of each instr
	inreg: set Inreg,
	inaddr: set Inaddr, // only relevant for loads and stores
	outreg: set Outreg,
	inmem: set Inmem,
	outmem: set Outmem,

	// boolean variables showing state of instr
	isresolved: lone rBool,
	iscommitted: lone cBool,
	isxm: lone tBool,
}

// boolean state sets
fun committed : Instruction {iscommitted.cBool}
fun resolved : Instruction {isresolved.rBool}
fun xm : Instruction {isxm.tBool}

// kind-based instruction sets (replaces subsig membership)
fun Loads    : Instruction { kind.TLoad    }
fun Stores   : Instruction { kind.TStore   }
fun Branchns : Instruction { kind.TBranchn }
fun Branchxs : Instruction { kind.TBranchx }
fun Otherns  : Instruction { kind.TOthern  }
fun Otherxs  : Instruction { kind.TOtherx  }
fun Branches : Instruction { Branchns + Branchxs }                              -- [sk-12]
fun Others   : Instruction { Otherns + Otherxs }                                -- [sk-6]

// operands s.t. we can have operand->operand dependency graphs
abstract sig Operand {
	opstate: one State,
	rf: set Operand,
	ddi: set Operand,
}

sig Inreg extends Operand {}
sig Inaddr extends Operand {}
sig Inmem extends Operand {}
sig Outreg extends Operand {}
sig Outmem extends Operand {}

fun ins : Instruction -> Operand {inreg+inmem+inaddr}
fun outs : Instruction -> Operand {outreg+outmem}
fun operands : Instruction -> Operand {ins+outs}

/*********************************************************************************
 * §2 Facts.  (W) well-formedness: what makes a graph a program execution.
 *            (V) vocabulary bounds: search bounds, not meaning (real x86 breaks them).
 *            (G) generation-only: what makes an instance a useful test.      -- [sk-16]
 */

// (W) operands belong to exactly one instruction; every state is used
fact no_extra_ops {no (Operand - Instruction.operands)}
fact no_extra_State {no State - Operand.opstate}
fact limited_instr_per_op {all o: Operand | one o.(~operands)}                -- [sk-3] was #(..) = 1

// (W) operand flavours
fact ir_s {no (Inreg.opstate & Mem_s)}
fact ia_s {no (Inaddr.opstate & Mem_s)}
fact im_s {no (Inmem.opstate & Reg_s)}
fact or_s {no (Outreg.opstate & Mem_s)}
fact om_s {no (Outmem.opstate & Reg_s)}

// (W) which operands each kind has
fact ld_ops   {no Loads.(inreg+outmem)}                          // load takes addr and mem and modifies reg
fact str_ops  {no Stores.(inmem+outreg)}                         // store takes addr and reg and modifies mem
fact other_ops {no Others.(inaddr+inmem+outmem)}                // other is some nonmem instr
fact br_ops   {no Branches.(inaddr+inmem+outmem+outreg)}        // branch is some control (no output)

// (V) operand-count caps, written without # so Int bitwidth cannot wrap them   -- [sk-3]
fact limited_inregs  {all i: Instruction | all a: i.inreg | lone (i.inreg - a)}  // <= 2
fact limited_inaddrs {all i: Instruction | lone i.inaddr}                         // <= 1
fact limited_inmems  {all i: Instruction | lone i.inmem}                          // <= 1
fact limited_ins     {all i: Instruction | all a: i.ins | lone (i.ins - a)}      // <= 2
fact limited_outs    {all i: Instruction | lone i.outs}                           // <= 1

// (W) spo is a total order (a chain)
fact spo_acyclic { acyclic[spo] }
fact spo_prior { all i: Instruction | lone i.(~spo) }
fact spo_total { total[spo, Instruction] }

// (W) committed => resolved; committed is a prefix of spo                      -- [sk-4]
fact committed_resolved {committed in resolved}
fun uncommitted : Instruction {Instruction - committed}
fun unresolved : Instruction {Instruction - resolved}
fact committed_last {no uncommitted <: ^spo :> committed}
fun last_committed : Instruction {(committed <: spo :> uncommitted).uncommitted}
fun first_uncommitted : Instruction {(some committed) => committed.(committed <: spo :> uncommitted) else first_instr}
fun first_instr : Instruction {Instruction - Instruction.spo}

// (W) GL-IFT-ish ddi edges, + rf edges
fact constrainddi {no ddi - (~ins).outs}
fact constrainrf {rf in (Instruction.outs -> Instruction.ins)}
fact one_entering_rf {all o: Operand | lone rf.o}
fact unidirectional_rf {acyclic[(operands).rf.(~operands) + spo]}
fact same_state_rf {no ((~opstate).rf.opstate - iden)}

// [Option A] rf must read from the MOST-RECENT writer of the state:
// forbid another writer of the same state spo-between an rf producer and its use.
fact rf_from_most_recent_writer {
  all prod: Instruction.outs, use: prod.rf |
    no other: (Instruction.outs - prod) |
        other.opstate = prod.opstate
        and (prod.(~operands))  -> (other.(~operands)) in ^spo
        and (other.(~operands)) -> (use.(~operands))   in ^spo
}

fact ld_ddi    {no (Loads.operands <: ddi) - (Inmem->Outreg)}
fact str_ddi   {no (Stores.operands <: ddi) - (Inreg->Outmem)}
fact other_ddi {no (Others.operands <: ddi) - (Inreg->Outreg)}
fact br_ddi    {no (Branches.operands <: ddi)}

// [sk-17] P5 "unfed reads" (OPT-IN, NOT APPLIED; Anna: P5 deliberately off).
// A read of a state some older instruction writes must have an rf edge (then, with
// rf_from_most_recent_writer, from the newest such writer). Stage 2 maps a state to
// one physical register, so an unfed read really reads that writer's value; for
// STT this only makes duplicate programs, for SPT it causes the "declassified"
// false positives (round 4). Conjoin `rf_complete` to a run to try it.
pred rf_complete {
  all u: Instruction.ins |
    (some w: Instruction.outs | w.opstate = u.opstate and (w.(~operands)) -> (u.(~operands)) in ^spo)
      => some rf.u
}

/*********************************************************************************
 * Alloy shortcuts
 */
pred irreflexive[rel: Instruction->Instruction]       { no iden & rel }
pred acyclic[rel: Instruction->Instruction]           { irreflexive[^rel] }
pred total[rel: Instruction->Instruction, bag: Instruction] {
  all disj e0, e1: bag | e0->e1 in ^rel + ~(^rel)
  acyclic[rel]
}

/*********************************************************************************
 * §3 Perturbations (relaxations): p : PTag -> univ names what is relaxed.
 */
abstract sig PTag {}
one sig RO extends PTag {} // remove operand
one sig RC extends PTag {} // make instruction committed when it previously wasnt
one sig RR extends PTag {} // make instruction resolved when it previously wasnt
one sig RI extends PTag {} // remove instruction
one sig RS extends PTag {} // remove state
fun no_p : PTag->univ {
  (PTag->univ) - (PTag->univ)
}

/*********************************************************************************
 * §4 The perturbed program
 */
fun committed_p[p: PTag->univ] : Instruction {committed + p[RC] - p[RI]}
fun uncommitted_p[p: PTag->univ] : Instruction {uncommitted - p[RC] - p[RI]}
fun resolved_p[p: PTag->univ] : Instruction {resolved + p[RR] - p[RI]}
fun unresolved_p[p: PTag->univ] : Instruction {unresolved - p[RR] - p[RI]}

fun i_p[p: PTag->univ] : Instruction {Instruction - p[RI]}
fun o_p[p: PTag->univ] : Operand {i_p[p].operands :> (Operand - p[RO] - opstate.(p[RS]))}

// [sk-5] immediate successor among the surviving instructions
fun spo_p[p : PTag->univ] : Instruction->Instruction {
	let s = i_p[p] <: ^spo :> i_p[p] | s - s.s
}

// [sk-6] removing an ALU op keeps its dataflow (RI collapses the instruction):
// producer -> consumer across any chain of removed ALU ops, on surviving operands.
fun rf_bridge_p[p : PTag->univ] : Operand -> Operand {
	o_p[p] <: (rf.^((ddi :> (p[RI] & Others).operands).rf)) :> o_p[p]
}
fun fix_rf_hole_p[p : PTag->univ] : Operand -> Operand {rf_bridge_p[p]}   -- [sk-6] old name, alias

fun rf_p[p : PTag->univ] : Operand -> Operand {o_p[p]<:rf:>o_p[p] + rf_bridge_p[p]}
fun ddi_p[p : PTag->univ] : Operand -> Operand {o_p[p]<:ddi:>o_p[p]}

fun op_edges_p[p: PTag->univ] : Operand -> Operand {rf_p[p] + ddi_p[p]}

fun f[p: PTag->univ] : Instruction {(i_p[p]) - (i_p[p]).(spo_p[p])}

/*********************************************************************************
 * §5 Library for defense blocks (all perturbation-aware)                     -- [sk-11..13]
 */
// [sk-12] speculation sources: the instructions spo-after an unresolved S-instruction
fun after_unresolved_p[p: PTag->univ, S: set Instruction] : set Instruction {
	(unresolved_p[p] & S).(^(spo_p[p]))
}
fun has_unresolved_brs_p[p: PTag->univ] : Instruction {after_unresolved_p[p, Branches]}            // STT_6 (same body)
fun has_unresolved_strs_p[p: PTag->univ] : Instruction {after_unresolved_p[p, Stores]}             // STT_6_stl (same body)
fun has_unresolved_brs_strs_p[p: PTag->univ] : Instruction {after_unresolved_p[p, Branches + Stores]} // STT_6_shadows (same body)
fun has_unresolved_any_p[p: PTag->univ] : Instruction {after_unresolved_p[p, Instruction]}         // STT_6_futuristic (same body)
// kept for existing defense blocks (same bodies as STT_6.als)
fun no_unresolved_brs_p[p: PTag->univ] : Instruction {i_p[p] - has_unresolved_brs_p[p]}
fun no_unresolved_brs_bf_or_is_p[p: PTag->univ] : Instruction {no_unresolved_brs_p[p] - (unresolved_p[p] & Branches)}

// [sk-11] declassification hook: instructions that have reached their visibility
// point under THIS model's contract (clause 1). Untaint rules should use this,
// not a re-derived "no unresolved branch before me".
fun nonspeculative_p[p: PTag->univ] : Instruction {i_p[p] - speculation_contract_p[p]}
fun spec_loads_p[p: PTag->univ] : Instruction {Loads & speculation_contract_p[p]}

// [sk-13] perturbed operand fields (domain = surviving instructions, range = surviving operands)
fun inreg_p[p: PTag->univ]  : Instruction->Operand {i_p[p] <: inreg  :> o_p[p]}
fun inaddr_p[p: PTag->univ] : Instruction->Operand {i_p[p] <: inaddr :> o_p[p]}
fun inmem_p[p: PTag->univ]  : Instruction->Operand {i_p[p] <: inmem  :> o_p[p]}
fun outreg_p[p: PTag->univ] : Instruction->Operand {i_p[p] <: outreg :> o_p[p]}
fun outmem_p[p: PTag->univ] : Instruction->Operand {i_p[p] <: outmem :> o_p[p]}
// [sk-13] inputs with / without a producer in the perturbed program (unfed = reads initial state)
fun fed_p[p: PTag->univ] : Operand {o_p[p].(rf_p[p])}
fun unfed_p[p: PTag->univ] : Operand {(o_p[p] & Instruction.ins) - fed_p[p]}
// [sk-7] lift a set of states (locations) to the operands on them
fun ops_of[S: set State] : set Operand {S.(~opstate)}

/*********************************************************************************
 * §6 Leak semantics: protection set folded along spo, then reached over prot_flow_p
 */
fun leakage_function_p[p: PTag->univ] : Operand {leakage_function & o_p[p]}
fun speculative_xmit_p[p: PTag->univ] : Operand {leakage_function_p[p] <: speculation_contract_p[p].operands}
fun nonspeculative_xmit_p[p: PTag->univ] : Operand {leakage_function_p[p] & nonspeculative_p[p].operands}  -- [sk-11]

// [sk-7] Operand-typed protection set; seed clipped to the perturbed program
fun prot_seed_p[p: PTag->univ] : Operand {hardware_protection_policy[p] & o_p[p]}
fun a[p:PTag->univ, i:Instruction, o:Operand] : Operand { prot_set_propagation_p[p,i,o]}

//@@N-BEGIN fold (regenerated by derive_core_u.py resize --max-instr N)
// [sk-8] apply the step at each surviving position 0..5, in spo order
fun protset_p[p: PTag->univ] : Operand {
	let s = spo_p[p] | let i0 = f[p] | let i1 = i0.s | let i2 = i1.s | let i3 = i2.s | let i4 = i3.s | let i5 = i4.s |
		o_p[p] & a[p,i5, a[p,i4, a[p,i3, a[p,i2, a[p,i1, a[p,i0, prot_seed_p[p]]]]]]]
}
//@@N-END fold
fun last_committed_protset_p[p: PTag->univ] : Operand {protset_p[p]}          -- [sk-8] old name, alias

// [sk-9] the one definition of a leak: protected data reaching a speculative transmitter,
// [sk-10] over the block's prot_flow_p edges (STT_6: the closure over op_edges_p)
fun flagged_p[p: PTag->univ] : Operand {(protset_p[p]).*(prot_flow_p[p]) & speculative_xmit_p[p]}
pred secure_speculation_scheme_p[p: PTag->univ] {no flagged_p[p]}
pred one_leak_p[p: PTag->univ] {one flagged_p[p]}                            -- [sk-9] (pre-v2 SPT form, unused)
pred tag_xm_p {some flagged_p[no_p] & xm.operands}

// (G) exactly one designated transmitter, and it must leak                    -- [sk-16]
fact one_xm {one xm}                                                         -- [sk-3] was #(xm) = 1
fact tag_xm {tag_xm_p}
// (G) no extra instrs except branches, while interleave fake
fact no_extra_inst {no ((Instruction-Branchns) - operands.Operand)}

/*********************************************************************************
 * §7 Symmetry breaking: idx = spo rank, onto a prefix of the IX atoms       -- [sk-2]
 */
fact idx_injective { all disj a, b: Instruction | a.idx != b.idx }
fact idx_prefix    { (Instruction.idx).(~ix_next) in Instruction.idx }
fact idx_matches_spo {
	all disj a, b: Instruction | (b in a.^spo) <=> (b.idx in a.idx.^ix_next)
}

/*********************************************************************************
 * §8 Minimality (relaxations), as named predicates                           -- [sk-15]
 *   leaks      : the instance violates the leakage predicate
 *   min_RR[I]  : resolving any unresolved instruction of I (except the commit
 *                boundary) makes it secure
 *   min_RC     : at the boundary (first uncommitted instruction), committing AND
 *                resolving it makes it secure (RC is never tested alone)
 *   min_RS[S]  : removing any state of S (all its operands) makes it secure
 *   min_RI[I]  : removing any instruction of I makes it secure (Stage 1 only)
 *   min_RO[O]  : removing any operand of O makes it secure (off: Anna, RI-only)
 */
pred leaks { not secure_speculation_scheme_p[no_p] }
pred min_RR[I: set Instruction] { all i: (I & unresolved) - first_uncommitted | secure_speculation_scheme_p[RR->i] }
pred min_RC { secure_speculation_scheme_p[RC->first_uncommitted + RR->first_uncommitted] }
pred min_RS[S: set State] { all s: S | secure_speculation_scheme_p[RS->s] }
pred min_RI[I: set Instruction] { all i: I | secure_speculation_scheme_p[RI->i] }
pred min_RO[O: set Operand] { all o: O | secure_speculation_scheme_p[RO->o] }

// flat / Stage-1.5 generator = STT_6.als's gen_useful_litmus, clause for clause
pred gen_useful_litmus {
  leaks
  min_RR[Instruction]
  min_RC
  min_RS[State]
}
// Stage-1 core generator: + instruction-minimality (RI-only; Anna 2026-11-08)
pred gen_core {
  gen_useful_litmus
  min_RI[Instruction]
}

/*********************************************************************************
 * §9 Run (the FIRST command is what a6CountModels / pipeline.py enumerate)    -- [sk-18]
 */
//@@RUN-BEGIN
// [STAGE-1 CORE] minimality = RR + RC + RS + RI (gen_core); up to 6 instructions; idx symmetry break kept ([sk-2])
run gen_lit {
  gen_core
} for 9 but 6 Instruction, exactly 1 rBool, exactly 1 cBool, exactly 1 tBool
//@@RUN-END

/*********************************************************************************
 * §10 Specific defense model — the slot. Everything above is the skeleton and is
 *     duplicated verbatim in every model (derive_core_u.py check enforces it).
 *
 * A block defines, with these exact signatures:
 *   fun speculation_contract_p[p: PTag->univ] : Instruction {...}                 (1)
 *   fun hardware_protection_policy[p: PTag->univ] : Operand {...}                (2) seed
 *   fun prot_set_propagation_p[p: PTag->univ, i: Instruction, o: Operand] : Operand {...}
 *                                                                                (2) step
 *   fun prot_flow_p[p: PTag->univ] : Operand->Operand {...}                      (2) flow
 *   fun leakage_function : Operand {...}            (3)  -- keep on ONE line
 *                                                        (partition_stage1.py reads it)
 * and may add tagged contract side-condition facts (e.g. STL's true-alias fact).
 */
//@@DEFENSE-BEGIN
/*********************************************************************************
 * Specific defense model STT (non-spec on commit) — the STT_6.als defense block
 * (STT_6.als:320-332), ported to the SKELETON_u interface with the SAME semantics
 * (location-based protection; checked equal to STT_6.als under every perturbation
 * gen_useful_litmus / gen_core use: queries/q_sem_eq.als). Each line carries the
 * STT_6.als original as a comment. This is the plug-in demo block, not a proposal
 * for a new STT semantics (that is the STT agent's STT_6_u.als).
 */

// (1) speculation contract — unchanged
//fun speculation_contract_p[p: PTag->univ] : Instruction {uncommitted_p[p] & (no_unresolved_brs_p[p] + no_unresolved_mem_p[p])}
fun speculation_contract_p[p: PTag->univ] : Instruction {uncommitted_p[p] & has_unresolved_brs_p[p]}

// (2) protection set
// seed. STT_6.als: fun hardware_protection_policy: State {Mem_s}
fun hardware_protection_policy[p: PTag->univ] : Operand {ops_of[Mem_s]}
// step. STT_6.als: s - (Loads & no_unresolved_brs_bf_or_is_p[p] & i).inmem.opstate
// (a load that reached its visibility point makes its whole LOCATION public;
//  nonspeculative_p = no_unresolved_brs_bf_or_is_p on loads, checked in q_sem_eq)
fun prot_set_propagation_p[p: PTag->univ, i: Instruction, o: Operand] : Operand {
	o - ops_of[(Loads & nonspeculative_p[p] & i).inmem.opstate]
}
// flow. STT_6.als: implicit (secure_speculation_scheme_p closes over ^(op_edges_p[p]))
fun prot_flow_p[p: PTag->univ] : Operand->Operand {op_edges_p[p]}

// (3) leakage function — unchanged
//fun leakage_function : Operand {Loads.inaddr+(Branchxs+Otherxs).inreg}
fun leakage_function : Operand {Loads.inaddr+(Branchxs).inreg}
//@@DEFENSE-END
