// OTB-shape search: 500 STT_6 xml instances × 8 chain-interleave variants,
// num_chains=1.  mispredict_not_taken only.  No gem5 — generation only.
{
  "paths": {
    "alloy_stage":        "STAGE1_alloy",
    "models_dir":         "STAGE1_alloy/models",
    "stage2_dir":         "STAGE2_compilation",
    "instruction_tables": "STAGE2_compilation/instruction_tables/instructions.jsonc",
    "stage3_dir":         "STAGE3_gem5",
    "testset_dir":        "testsets",
    "results_dir":        "results",
    "results_name":       "_otb_search_c1"
  },

  "alloy": {
    "max_instances": 500,
    "batch_size":    500
  },

  "speculation": {
    "control_flow": true,
    "data_flow":    false,
    "branch_modes": ["mispredict_not_taken"]
  },

  "pipeline": {
    "check":    "per_type",
    "keep_tmp": false
  },

  "interleave": {
    "enabled":               true,
    "variants_per_instance": 8,
    "free_pool": {
      "reg": 8,
      "mem": 3
    },
    "chain": {
      "min_length": 2,
      "max_length": 4,
      "step_kinds": ["other_n", "ld", "str"]
    },
    "num_chains": 1
  }
}
