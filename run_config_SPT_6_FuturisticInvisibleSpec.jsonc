// SPT_6 sweep variant: FuturisticSafeInvisibleSpec: ROB-head + invisible spec — strongest defense
// Reuses /tests/simspect/testsets/SPT_6 (same .s and .ann.json), only Phase 4 reruns.
{
  "paths": {
    "alloy_stage":        "STAGE1_alloy",
    "models_dir":         "STAGE1_alloy/models",
    "stage2_dir":         "STAGE2_compilation",
    "instruction_tables": "STAGE2_compilation/instruction_tables/instructions.jsonc",
    "stage3_dir":         "STAGE3_gem5",
    "testset_dir":        "testsets",
    "results_dir":        "results",
    "results_name":       "SPT_6_FuturisticInvisibleSpec"
  },
  "alloy":         { "max_instances": 5000, "batch_size": 500 },
  "speculation":   { "control_flow": true, "data_flow": false, "branch_modes": ["mispredict_not_taken"] },
  "gem5": {
    "binary":                  "/work/gem5-spt/build/X86_MESI_Two_Level/gem5.opt",
    "config_script":           "/work/gem5-spt/configs/example/se.py",
    "branch_ann_enable":       true,
    "cpu_type":                "DerivO3CPU",
    "scheme":                  2,
    "caches":                  true,
    "jobs": 12,
    "debug_flags":             ["O3PipeView", "LSQUnit"],
    "debug_file":              "pipeview.txt",
    "fnc_commit_stall_cycles": 150,
    "sample_fraction":         1.0,
    "extra_args":              ["--scheme=FuturisticSafeInvisibleSpec", "--applyDDIFT=1", "--fwdUntaint=1", "--bwdUntaint=1", "--configImpFlow=Ignore"]
  },
  "sweep":         { "enabled": false, "points": [0], "unresolved_stall_cycles": 5000 },
  "pipeline":      { "check": "per_type", "keep_tmp": false }
}
