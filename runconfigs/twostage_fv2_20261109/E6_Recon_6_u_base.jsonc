// E6 on Recon_6_u_base, 2% top-up (sample 0.02; superset of the 1%). simspect-c8 autopilot 2026-11-09.
{
  "paths": {
    "alloy_stage": "STAGE1_alloy",
    "models_dir": "STAGE1_alloy/models",
    "stage2_dir": "STAGE2_compilation",
    "instruction_tables": "STAGE2_compilation/instruction_tables/proposed/fv2_vocab.jsonc",
    "stage3_dir": "STAGE3_gem5",
    "testset_dir": "testsets_twostage",
    "results_dir": "results",
    "results_name": "E6_Recon_6_u_base"
  },
  "alloy": {
    "max_instances": 93092,
    "batch_size": 1000
  },
  "speculation": {
    "control_flow": true,
    "data_flow": false,
    "branch_modes": [
      "mispredict_not_taken",
      "mispredict_taken"
    ]
  },
  "gem5": {
    "binary": "/work/gem5-recon-ruby3/build/X86/gem5.opt",
    "config_script": "/work/gem5-recon-ruby3/configs/example/se_ruby.py",
    "branch_ann_enable": true,
    "cpu_type": "X86O3CPU",
    "scheme": 2,
    "caches": true,
    "jobs": 16,
    "debug_flags": [
      "O3PipeView",
      "LSQUnit"
    ],
    "debug_file": "pipeview.txt",
    "fnc_commit_stall_cycles": 0,
    "allow_leaked": true,
    "extra_args": [
      "--ruby",
      "--l0d_size=65536",
      "--l0i_assoc=8",
      "--l0d_assoc=8",
      "--l0i_size=65536",
      "--l1d_size=2MB",
      "--l1d_assoc=16",
      "--l2_size=16MB",
      "--l2_assoc=32",
      "--cacheline_size=64"
    ],
    "sample_fraction": 0.02
  },
  "sweep": {
    "enabled": true,
    "points": [
      0,
      500,
      2500
    ],
    "unresolved_stall_cycles": 5000,
    "unresolved_stall_per_branch": {
      "mode": "random",
      "choices": [
        2500,
        5000,
        10000
      ],
      "seed": 0
    }
  },
  "pipeline": {
    "check": "per_type",
    "keep_tmp": false
  },
  "interleave": {
    "enabled": false
  },
  "reg_naming": {
    "mode": "random",
    "seed": 0
  },
  "branch_cond": {
    "from_alloy": true
  }
}
