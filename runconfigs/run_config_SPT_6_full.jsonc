// SPT_6 full run on /work/gem5-spt (X86_MESI_Two_Level build with BTB-force +
// resolve-stall + fnc-commit-stall hooks; --scheme=2 → SpectreSafeFence via
// se.py). Same SPT-defense extra_args as the in-flight small smoke run
// (run_config_SPT_6.jsonc) but scaled to match the other "full" builds:
// 100k alloy instances, both branch modes, 3-point stall sweep, jobs=16,
// fnc-stall 150 cycles. NO interleave.
//
// Uses model name SPT_6_full (symlinked to SPT_6.als in
// STAGE1_alloy/models/) so its testset dir is isolated from the small
// smoke at testsets/SPT_6/. Results land in results/SPT_6_full/.
{
  "paths": {
    "alloy_stage":        "STAGE1_alloy",
    "models_dir":         "STAGE1_alloy/models",
    "stage2_dir":         "STAGE2_compilation",
    "instruction_tables": "STAGE2_compilation/instruction_tables/instructions.jsonc",
    "stage3_dir":         "STAGE3_gem5",
    "testset_dir":        "testsets",
    "results_dir":        "results",
    "results_name":       "SPT_6_full"
  },

  "alloy": {
    "max_instances": 100000,
    "batch_size":    1000
  },

  "speculation": {
    "control_flow": true,
    "data_flow":    false,
    "branch_modes": ["mispredict_not_taken", "mispredict_taken"]
  },

  "gem5": {
    "binary":                  "/work/gem5-spt/build/X86_MESI_Two_Level/gem5.opt",
    "config_script":           "/work/gem5-spt/configs/example/se.py",
    "branch_ann_enable":       true,
    "cpu_type":                "DerivO3CPU",
    "scheme":                  2,
    "caches":                  true,
    "jobs":                    16,
    "debug_flags":             ["O3PipeView", "LSQUnit"],
    "debug_file":              "pipeview.txt",
    "fnc_commit_stall_cycles": 150,
    "sample_fraction":         1.0,
    "extra_args": [
      "--applyDDIFT=1",
      "--fwdUntaint=1",
      "--bwdUntaint=1",
      "--configImpFlow=Ignore"
    ]
  },

  "sweep": {
    "enabled":                 true,
    "points":                  [0, 500, 2500],
    "unresolved_stall_cycles": 5000
  },

  "pipeline": {
    "check":    "per_type",
    "keep_tmp": false
  },

  "interleave": {
    "enabled": false
  }
}
