// Fixed-harness campaign config (2026-10-30). Same build/scheme/extra_args/sweep as the
// campaign named in 'copied_from', with: fnc_commit_stall_cycles 0 (window = branches
// unresolved, observed via the BR resolve lines), derived branch force (force_plan),
// execution-validity gate, sample_fraction 0.02 for the first validation round.
// Design: wiki/design/RESOLUTION_HOOKS.md. copied_from: results/SPT_6_oneLP_fence/run_config.jsonc
{
  "paths": {
    "alloy_stage": "STAGE1_alloy",
    "models_dir": "STAGE1_alloy/models",
    "stage2_dir": "STAGE2_compilation",
    "instruction_tables": "STAGE2_compilation/instruction_tables/instructions.jsonc",
    "stage3_dir": "STAGE3_gem5",
    "testset_dir": "testsets",
    "results_dir": "results",
    "results_name": "SPT_6_oneLP_fence_fixed"
  },
  "alloy": {
    "max_instances": 100000,
    "batch_size": 1000
  },
  "speculation": {
    "control_flow": true,
    "data_flow": false,
    "branch_modes": [
      "mispredict_not_taken",
      "mispredict_taken"
    ]
  },
  "gem5": {
    "binary": "/work/gem5-spt/build/X86_MESI_Two_Level/gem5.opt",
    "config_script": "/work/gem5-spt/configs/example/se.py",
    "branch_ann_enable": true,
    "cpu_type": "DerivO3CPU",
    "scheme": 2,
    "caches": true,
    "jobs": 16,
    "debug_flags": [
      "O3PipeView",
      "LSQUnit"
    ],
    "debug_file": "pipeview.txt",
    "fnc_commit_stall_cycles": 0,
    "sample_fraction": 0.02,
    "extra_args": [
      "--applyDDIFT=1",
      "--fwdUntaint=1",
      "--bwdUntaint=1",
      "--configImpFlow=Lazy",
      "--freeParam=3",
      "--scheme=SpectreSafeFence"
    ]
  },
  "sweep": {
    "enabled": true,
    "points": [
      0,
      500,
      2500
    ],
    "unresolved_stall_cycles": 5000
  },
  "pipeline": {
    "check": "per_type",
    "keep_tmp": false
  },
  "interleave": {
    "enabled": false
  }
}
