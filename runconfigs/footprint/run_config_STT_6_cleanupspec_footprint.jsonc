{
  // CANONICAL footprint-run config (2026-11-08), tracked copy of results/STT_6_cleanupspec_full/run_config.jsonc.
  // Changed vs that file ONLY in the run glue: (1) paths.alloy_stage/models_dir/stage2_dir/stage3_dir/instruction_tables
  // added (without them pipeline.py raises KeyError: CleanupSpec v2 run README on cafe2,
  // /tests/simspect_fixed_20261030/results/STT_6_cleanupspec_v2hooks__20261107/README.md "Deviations" (1));
  // (2) testset_dir = testsets_latest; (3) debug_flags = ["O3PipeView"] only (check_footprint reads only that;
  // ProtocolTrace filled 15 GB on 40 pilot traces, and CleanupSpec's LSQUnit print corrupts hook lines);
  // (4) results_name STT_6_cleanupspec_footprint.
  // Anna 2026-11-08: keep the shrunk (amplified) caches for all footprint runs; never use a deadlocking setting.
  // TSO, sys clock and branch predictor are NOT decided for these runs and are left exactly as in the old file.
  // Run: make run MODEL=STT_6 RUNCONFIG=runconfigs/footprint/run_config_STT_6_cleanupspec_footprint.jsonc (on cafe2, tree /tests/simspect_fixed_20261030).
  // AMuLeT head-to-head comparisons use runconfigs/amulet_parity/ instead (wiki/findings/audits/2026-10-28/full_configs.md).
  // (5) CleanupSpec: --L1_TBEs=8 instead of 2 (Anna 2026-11-08): 8 is the smallest measured deadlock-free value; with 2,
  // 1861/3000 STT_6 tests deadlock (defense-independent Ruby TBE exhaustion). L2/DC TBEs stay 2, exactly the measured
  // deadlock-free main_tbe8 arm (3000/3000 complete).
  // CleanupSpec, FULL configuration (Ruby MESI_Two_Level, Cleanup_FOR_L1L2 = undo at L1D + L2, rand-L2, random L1 repl).
  // Written 2026-10-28 (scope-table session). NOT LAUNCHED. Every flag is justified in results/STT_6_cleanupspec_full/README.md.
  // First run_config for CleanupSpec: STT_6_cleanupspec_residue had only run_cleanupspec_residue.sh (env exports).
  // Differs from it by the paper's L1I/L2 associativity, explicit TBEs, dropping the inert --l2cache, and carrying
  // the launcher's max-tick in extra_args. Pipeline path: make run MODEL=STT_6 RUNCONFIG=results/<this dir>/run_config.jsonc.
  "paths": {
    "testset_dir":  "testsets_latest",
    "results_dir":  "results",
    "alloy_stage":        "STAGE1_alloy",
    "models_dir":         "STAGE1_alloy/models",
    "stage2_dir":         "STAGE2_compilation",
    "instruction_tables": "STAGE2_compilation/instruction_tables/instructions.jsonc",
    "stage3_dir":         "STAGE3_gem5",
    "results_name": "STT_6_cleanupspec_footprint",
    "model":        "STT_6"
  },
  "speculation": {
    "control_flow": true,
    "data_flow":    false,
    "branch_modes": ["mispredict_not_taken", "mispredict_taken"]
  },
  "filter": { "xmit_kind": "ld" },   // read by the launchers only, not by pipeline.py
  "gem5": {
    "binary":        "/work/amulet/amulet-gem5-CleanupSpec_AE-v1.1/build/X86_MESI_Two_Level/gem5.opt",
    "config_script": "/work/amulet/amulet-gem5-CleanupSpec_AE-v1.1/configs/example/se.py",
    "branch_ann_enable":       true,               // as run_cleanupspec_residue.sh:23
    "cpu_type":                "DerivO3CPU",
    "scheme":                  2,                  // auto --scheme=2 is accepted and ignored (Options.py:315-319)
    "jobs":                    4,                  // as run_cleanupspec_residue.sh:26
    "debug_flags":             ["O3PipeView"],   // check_footprint reads only O3PipeView (Commit is auto-added by gem5_common)
    "debug_file":              "pipeview.txt",
    "checker":                 "check_footprint.py",   // pipeline.py:304-312 override; reads only the O3PipeView simspect: lines
    "criterion":               "specs/leakage/cleanupspec.json",   // footprint criterion (criteria session); pipeline.py:599-614 -> SIMSPECT_CRITERION
    "fnc_commit_stall_cycles": 0,                  // as run_cleanupspec_residue.sh:13 default (">0 risks the assoc-2/install deadlock", :9)
    // Initial cache state (Anna 2026-11-09): CleanupSpec and SpecLFB default to "random" = each test runs warm or
    // cold (clflush of its stack frame), chosen per test from sha256(seed, stem); every record carries the
    // cache_setup it actually used. Not a standard run dimension; every other build stays warm.
    // STAGE3_gem5/cache_setup.py, wiki/design/SIMSPECT_HOOKS.md "Cache setup strategies".
    "cache_setup":             "random",
    "cache_setup_seed":        "simspect-cache-random-v1",   // = cache_setup.DEFAULT_SEED; changing it changes which tests run cold
    "extra_args": [
      "--ruby",                                    // CleanupSpec undo lives in the Ruby .sm files
      "--scheme_invisispec=UnsafeBaseline",        // no InvisiSpec on top (authors' exp_script/runscript.sh:267; AMuLeT executor.py:289)
      "--scheme_cleanupcache=Cleanup_FOR_L1L2",    // fullest scheme: superset of Cleanup_FOR_L1 + L2Inv + InternalInterferenceHit (Scheme.py:70-83)
      "--needsTSO=0",                              // authors' runscript.sh:267, AMuLeT executor.py:289, existing launcher :22
      "--l1d_size=2kB", "--l1d_assoc=4",           // SimSpect amplification, assoc>=4 (assoc-2 deadlocks: run_cleanupspec_residue.sh:10-11); paper Table 4 p9 = 64KB/8
      "--l1i_size=32kB", "--l1i_assoc=4",          // paper Table 4 p9; authors' runscript.sh:266
      "--l2_size=2MB",  "--l2_assoc=16",           // paper Table 4 p9; runscript.sh:266
      "--L1_TBEs=8", "--L2_TBEs=3", "--DC_TBEs=2", // L1=8: Anna 2026-11-08 (2 deadlocks 62%); DC = the measured main_tbe8 arm
      // L2_TBEs 2 -> 3 (cache-random, 2026-11-09; principle: crash-free settings except for AMuLeT parity): with 2, cold
      // (and so random's cold half) panics CleanupSpec's own cleanup, MESI_Two_Level-L2cache.sm:308 "Invalid L1 forwarded
      // request type" (a PUTINV meets an L2 Resource Stall): 326/590 plain STT_6 tests. TBE sweep on those 590 stems
      // (cafe2 results/STT_6_rmwstems_cleanupspec_tbe_l2_{3,4,8,16}_dc_2_{cold,warm}__latest, summary
      // results/STT_6_cleanupspec_tbe_sweep_20261109.json, launcher STAGE3_gem5/triage/cache_setup_20261108/tbe_sweep.sh):
      // L2_TBEs 3, 4, 8, 16 cold -> 0/590 errors, 10 hits (the same stems as the 264 survivors at 2); warm -> 13 hits,
      // the same 13 stems as L2_TBEs=2 at every value. 3 is the smallest crash-free value; DC_TBEs unchanged.
      "--abs-max-tick=3000000000"                  // = run_cleanupspec_residue.sh:25 SIMSPECT_GEM5_MAX_TICK; overrides gem5_common.py:172 (optparse last-wins)
    ]
  },
  // 1-point sweep = the launchers' inject_stalls (mispredict branches held 5000 cyc, xmit branch 0): pipeline.py:402-426.
  // enabled:true is required on the pipeline path; with false, pipeline.py injects no stall (the old configs relied on the launcher).
  "sweep": { "enabled": true, "points": [0], "unresolved_stall_cycles": 5000 },
  "legacy_checker": "STAGE3_gem5/check_ld_cleanupspec.py",   // the earlier direct-checker path (needs debug flags this config no longer sets: add them back to use it); for comparison only
  "pipeline": { "check": "per_type", "keep_tmp": false }
}
