+void
+LSQUnit::predictLoad(const DynInstPtr &load_inst)
+{
+    assert(load_inst->predInst.predictedAddress != 0);
+
+    if (load_inst->isSquashed()) return;
+
+    Addr pred = load_inst->predInst.predictedAddress;
+    uint32_t packetSize = load_inst->predInst.predictedSize;
+
+    if (packetSize == 0) return;
+
+    auto flags = LSQRequest::Flag::IsLoad;
+    LSQRequest *req = new LSQ::PredictDataRequest(this, load_inst,
+                                        pred, packetSize,
+                                        flags);
+
+    bool needs_burst = transferNeedsBurst(pred, packetSize, 64);
+
+    if (needs_burst) {
+        assert(!req->isAnyOutstandingRequest());
+        req->discard();
+        load_inst->predInst.hasPred = false;
+        return;
+    }
+
+    req->_byteEnable = std::vector<bool>(packetSize, true);
+
+    req->initiateTranslation();
+
+    if (!load_inst->predInst.predData) {
+        load_inst->predInst.predData = new uint8_t[req->mainReq()->getSize()];
+    }
+
+    if (!req->isMemAccessRequired()) {
+        // todo: delayed predictions?
+        ++stats.delayedTranslationPredictions;
+        req->discard();
+        load_inst->predInst.hasPred = false;
+        return;
+        //panic("We are always in the same page");
+    }
+
+    req->buildPackets();
+
+    bool sent = dcachePort->sendTimingReq(req->_packets.at(0));
+
+    if (sent) {
+        ++stats.issuedPredictions;
+        cpu->predictionUnit.insertIssuedLoad(load_inst);
+        req->_numOutstandingPackets = 1;
+        load_inst->predInst.predRequest = req;
+        load_inst->predInst.predIssuedCycle = cpu->curCycle();
+    } else {
+        ++stats.blockedPredictions;
+        assert(!req->isAnyOutstandingRequest());
+        req->discard();
+        load_inst->predInst.hasPred = false;
+    }
+
+    DPRINTF(AddrPrediction, "Load [sn:%llu] completed prediction "
+        "sent: %d, pred: %#x, predicate: %d, size: %d\n",
+        load_inst->seqNum,
+        sent,
+        pred,
+        load_inst->readPredicate(),
+        packetSize);
+}
+
+bool
+LSQUnit::verifyPrediction(const DynInstPtr &load_inst)
+{
+    assert(load_inst->predInst.predData ||
+           load_inst->predInst.storeData);
+
+    PredictionInstruction* pred = &load_inst->predInst;
+    LSQRequest* req = load_inst->savedRequest;
+
+    if (!pred->verifyData) {
+        pred->verifyData =
+            new uint8_t[pred->predictedSize];
+        memset(pred->verifyData, 0, load_inst->effSize);
+    }
+
+    req->mainReq()->setFlags(pred->flags);
+    PacketPtr snoop = Packet::createRead(req->mainReq());
+    snoop->dataStatic(pred->verifyData);
+    dcachePort->sendFunctional(snoop);
+
+    bool equal = true;
+    for (int i = 0; i < pred->predictedSize; i++) {
+        if (pred->validStoreData)
+            equal = equal &&
+                pred->verifyData[i] == pred->storeData[i];
+        else
+            equal = equal &&
+                pred->verifyData[i] == pred->predData[i];
+    }
+
+    delete snoop;
+    snoop = nullptr;
+
+    return equal;
+}
+
+void
+LSQUnit::forwardData(const DynInstPtr &load_inst, int load_idx)
+{
+
+    if (cpu->scheme == CPU::Scheme::DoM &&
+        load_inst->predInst.cacheLevels > 1 &&
+        load_inst->isSpeculative()) {
+          cpu->delayUnit.insertDelayedMem(load_inst);
+          return;
+    }
+
+    assert(load_inst->savedRequest);
+    DPRINTF(AddrPrediction, "Forwarding predicted data for "
+            "load [sn:%llu], storeData: %d, size: %d, "
+            "fromStore: %d, partialFault: %d\n",
+            load_inst->seqNum,
+            load_inst->predInst.validStoreData,
+            load_inst->effSize,
+            load_inst->predInst.validStoreData,
+            load_inst->predInst.partial);
+    LSQRequest* request = load_inst->savedRequest;
+
+    if (load_inst->predInst.partial)
+        iewStage->blockMemInst(load_inst);
+
+    bool correct = verifyPrediction(load_inst);
+
+    if (!correct) {
+        if (load_inst->predInst.validStoreData) {
+            ++stats.storeMemoryVariance;
+        } else {
+            ++stats.wrongDataPredictions;
+        }
+    }
+
+    if (!load_inst->memData) {
+        load_inst->memData =
+            new uint8_t[request->mainReq()->getSize()];
+    }
+
+    if (load_inst->predInst.validStoreData &&
+        !correct) {/* &&
+        (cpu->curCycle() - load_inst->predInst.storeWriteCycle)
+            < Cycles(50)) {
+        load_inst->predInst.shouldForward = false;
+        load_inst->predInst.successfulPred = false;
+        iewStage->blockMemInst(load_inst);
+        return; */
+        memcpy(load_inst->memData,
+               load_inst->predInst.storeData,
+               request->mainReq()->getSize());
+    } else {
+        memcpy(load_inst->memData,
+               load_inst->predInst.verifyData,
+               request->mainReq()->getSize());
+    }
+
+    load_inst->predInst.wrotePredictedData = true;
+
+    if (cpu->scheme == CPU::Scheme::Delay &&
+        load_inst->isSpeculative()) {
+        cpu->delayUnit.insertDelayedMem(load_inst);
+        return;
+    } else if (cpu->scheme == CPU::Scheme::STT &&
+        (!cpu->sttBypass) &&
+        cpu->taintTracker.isTaintedInst(load_inst)) {
+        panic("Should never end up here, check earlier");
+    }
+
+    PacketPtr data_pkt = new Packet(request->mainReq(),
+                    MemCmd::ReadReq);
+
+    data_pkt->dataStatic(load_inst->memData);
+
+    assert(!request->isAnyOutstandingRequest());
+
+    writeback(load_inst, data_pkt);
+    load_inst->savedRequest->writebackDone();
+    delete data_pkt;
+}
