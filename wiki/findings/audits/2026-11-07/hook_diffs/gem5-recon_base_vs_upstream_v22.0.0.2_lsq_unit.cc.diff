+        return;
+    }
+
+    if (head_load_inst == loadQueue.front().instruction()->seqNum) {
+        stallCycles++;
+    } else {
+        stallCycles = 0;
+        head_load_inst = loadQueue.front().instruction()->seqNum;
+    }
+
+    assert(stallCycles < 10000);
+}
+
+void
+LSQUnit::snoop(PacketPtr pkt)
+{
+    dcachePort->sendFunctional(pkt);
+}
