+/**
+ * Annotation-driven store set predictor.  Extends the standard StoreSet with
+ * a per-load-PC override table loaded at construction time.  For any load PC
+ * present in the annotation map, checkInst() forces that load into the same
+ * store set as the mapped store PC (via violation()) before performing the
+ * normal lookup, ensuring a dependency stall is generated whenever that store
+ * has been recently fetched.  All other loads follow the unmodified StoreSet
+ * behaviour.
+ *
+ * This class is intentionally NOT wired into MemDepUnit or BaseO3CPU.  To
+ * activate it:
+ *   1. Replace `StoreSet depPred` with `AnnotatedStoreSet depPred` in
+ *      cpu/o3/mem_dep_unit.hh.
+ *   2. Pass annotation vectors through BaseO3CPUParams (add
+ *      annotationLoadPCs / annotationForcedStorePCs VectorParam.Addr fields
+ *      to cpu/o3/BaseO3CPU.py) and forward them in MemDepUnit's constructor.
+ *
+ * Annotation semantics mirror the BTB forced-target annotation in
+ * cpu/pred/bpred_unit.{hh,cc}: each aligned index pair
+ * (annotationLoadPCs[i], annotationForcedStorePCs[i]) declares that load PC i
+ * should always be treated as dependent on store PC i, regardless of whether a
+ * real memory ordering violation has ever been observed between them.
+ */
+class AnnotatedStoreSet : public StoreSet
+{
+  public:
+    /**
+     * Creates an AnnotatedStoreSet with the given table sizes and annotation
+     * vectors.  The two annotation vectors must have the same length; a fatal
+     * error is raised otherwise.
+     *
+     * @param clear_period   Passed through to StoreSet.
+     * @param SSIT_size      Passed through to StoreSet.
+     * @param LFST_size      Passed through to StoreSet.
+     * @param annot_load_pcs Load PCs whose store-set membership is overridden.
+     * @param annot_store_pcs For each load PC at the matching index, the store
+     *                        PC that is unconditionally placed in that load's
+     *                        store set.
+     */
+    AnnotatedStoreSet(uint64_t clear_period, int SSIT_size, int LFST_size,
+                      const std::vector<Addr> &annot_load_pcs,
+                      const std::vector<Addr> &annot_store_pcs);
+
+    /** Default constructor.  init() must be called before use. */
+    AnnotatedStoreSet() {}
+
+    /**
+     * Checks if the instruction at PC is dependent on any store.
+     *
+     * For load PCs present in the annotation map this first calls
+     * violation(forced_store_pc, PC) to guarantee the two instructions share
+     * a store set (re-establishing the relationship after any periodic clear),
+     * then falls through to the standard StoreSet::checkInst() lookup.
+     *
+     * NOTE: because StoreSet::checkInst() is not declared virtual, this method
+     * shadows rather than overrides it.  MemDepUnit must hold an
+     * AnnotatedStoreSet (not a StoreSet pointer) for static dispatch to reach
+     * this implementation.
+     *
+     * @return Sequence number of the store this load must wait for, or 0.
+     */
+    InstSeqNum checkInst(Addr PC);
+
+  private:
+    /**
+     * Annotation-driven override map loaded at construction time.
+     * Maps load_PC -> forced_store_PC.
+     */
+    std::unordered_map<Addr, Addr> annotForcedStore;
+};
+
+} // namespace o3
