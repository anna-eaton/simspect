+    # [SimSpect slow-comm experiment] Env-driven O3 timing overrides. Each is
+    # applied only when its env var is set, so an unset var leaves the stock
+    # default. backComSize/forwardComSize MUST exceed the IEW<->commit delays
+    # (timebuffer depth: wires read at getWire(-delay)). Runtime params only.
+    import os as _os
+    def _envi(name):
+        v = _os.environ.get(name)
+        return int(v) if v not in (None, "") else None
+    _iewc   = _envi("SIMSPECT_IEW_COMMIT_DELAY")
+    _comiew = _envi("SIMSPECT_COMMIT_IEW_DELAY")
+    _back   = _envi("SIMSPECT_BACK_COM_SIZE")
+    _fwd    = _envi("SIMSPECT_FWD_COM_SIZE")
+    _sqw    = _envi("SIMSPECT_SQUASH_WIDTH")
+    for cpu in system.cpu:
