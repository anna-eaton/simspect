        "sources": ["AMULET p11 Fig.6 (CMOVL EAX, dword ptr [...]; OR EDI, dword ptr [R14+RAX])", "SPT p8 §7.2 (R[31:0])"],
        "emitter_change": "copy of 'load' with movl and the ${0:k} operand modifier", "stl_eval": "read 4 bytes, zero-extend" },
