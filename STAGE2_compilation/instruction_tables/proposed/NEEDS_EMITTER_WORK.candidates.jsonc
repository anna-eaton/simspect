        "defenses": ["STT", "ReCon", "SPT", "InvisiSpec", "CleanupSpec", "SpecLFB", "DoM", "Delay", "STL"],
        "sources": ["NDA p8 Fig.6 (movzx eax,[rax]; movzx edx,[rdx+rax*1])", "SPT p8 §7.2 (4 partial-register taint bits), p9 §7.5 (byte-granular shadow L1)",
                    "RECON §4.4 (reveal only aligned, word granularity)", "INVISI p1 (1-byte value V)", "G5 data_transfer/move.py:148-151 (ld dataSize=1 + zexti)"],
        "emitter_change": "copy of the 'load' branch with mnemonic movzbq", "stl_eval": "read 1 byte, zero-extend" },
