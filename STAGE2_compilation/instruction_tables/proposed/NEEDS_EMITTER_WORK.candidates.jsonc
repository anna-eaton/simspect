        "defenses": ["STT", "ReCon", "SPT", "InvisiSpec", "CleanupSpec", "SpecLFB", "DoM", "Delay", "STL"],
        "sources": ["AMULET p10 Fig.4 (CMOVNBE SI, word ptr [R14+RAX])", "SPT p8 §7.2 (R[15:0] access mode)"],
        "emitter_change": "copy of 'load' with movzwq", "stl_eval": "read 2 bytes, zero-extend" },
      { "name": "load_32", "asm": "movl (%probe,%idx,1), ${0:k}   (32-bit name of the pinned outreg; zero-extends)", "uses": ["inaddr", "inmem", "outreg"],
