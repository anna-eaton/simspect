// bugsynth OTB campaign — getOldestTaint on /work/gem5-recon-modded (scheme2 + allow_leaked).
// Model STT_6_otb2s.als (OTB class predicate) + interleave ON so pass_interleave injects the
// 2nd tainted load (differing spec status) onto the ALU's free 2nd operand. All paths isolated
// under bugsynth/. ROOT = bugsynth/ (pipeline.py is the copy there).
{
  "paths": {
    "alloy_stage":        "../STAGE1_alloy",
    "models_dir":         "models",
    "stage2_dir":         "STAGE2_compilation",
    "instruction_tables": "STAGE2_compilation/instruction_tables/instructions.jsonc",
    "stage3_dir":         "STAGE3_gem5",
    "testset_dir":        "testsets",
    "results_dir":        "results",
    "results_name":       "STT_6_otb2s"
  },

  "alloy": {
    "max_instances": 200,
    "batch_size":    500
  },

  "speculation": {
    "control_flow": true,
    "data_flow":    false,
    "branch_modes": ["mispredict_not_taken"]
  },

  "gem5": {
    "binary":            "/work/gem5-recon-modded/build/X86/gem5.opt",
    "config_script":     "/work/gem5-recon-modded/configs/example/se.py",
    "branch_ann_enable": true,
    "cpu_type":          "X86O3CPU",
    "scheme":            2,
    "allow_leaked":      true,
    "caches":            true,
    "jobs":              8,
    "debug_flags":       ["O3PipeView", "LSQUnit"],
    "debug_file":        "pipeview.txt"
  },

  "sweep": {
    "enabled":                 true,
    "points":                  [0, 500, 2500],
    "unresolved_stall_cycles": 5000
  },

  "pipeline": {
    "check":    "per_type",
    "keep_tmp": false
  }
}
