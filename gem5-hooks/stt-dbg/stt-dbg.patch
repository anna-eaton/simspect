diff --git a/configs/example/se.py b/configs/example/se.py
index 0451e15..9392c7a 100644
--- a/configs/example/se.py
+++ b/configs/example/se.py
@@ -62,6 +62,44 @@ from common import CpuConfig
 from common import MemConfig
 from common.Caches import *
 from common.cpu2000 import *
+import json
+
+def load_branch_annotations(path, base):
+    with open(path, 'r') as f:
+        data = json.load(f)
+    if 'annotations' not in data:
+        fatal("branch annotation file %s has no 'annotations' key" % path)
+    branch_pcs, forced_targets, stall_cycles = [], [], []
+    for e in data['annotations']:
+        # Branch PC: prefer absolute `branch_addr` (new schema, written by
+        # compile_annotate.py); fall back to function-relative legacy fields
+        # which require `+ base`.
+        br_abs = e.get('branch_addr_hex') or e.get('branch_addr') or \
+                 e.get('branch_pc_addr_hex') or e.get('branch_pc_addr')
+        if br_abs is not None:
+            br = int(str(br_abs), 0)
+        else:
+            rel = e.get('x86_branch_offset_hex') or e.get('x86_branch_offset') or \
+                  e.get('x86_pc_offset_hex')      or e.get('x86_pc_offset')
+            if rel is None: continue
+            br = int(str(rel), 0) + base
+        # BTB-forced target: only applied for mispredict_taken. Prefer absolute
+        # `btb_forced_target_addr`; fall back to relative offset + base.
+        mode = e.get('mode', '')
+        if mode in ('correctly_not_taken', 'mispredict_not_taken'):
+            tgt = 0
+        else:
+            tgt_abs = e.get('btb_forced_target_addr_hex') or e.get('btb_forced_target_addr')
+            if tgt_abs is not None:
+                tgt = int(str(tgt_abs), 0)
+            else:
+                tgt_rel = e.get('btb_forced_target_x86_offset_hex') or e.get('btb_forced_target_x86_offset')
+                if tgt_rel is None: continue
+                tgt = int(str(tgt_rel), 0) + base
+        branch_pcs.append(br)
+        forced_targets.append(tgt)
+        stall_cycles.append(int(e.get('resolve_stall_cycles', 0)))
+    return branch_pcs, forced_targets, stall_cycles
 
