diff -ruN pristine/src/sim/simspect_hooks.cc hooked/src/sim/simspect_hooks.cc
--- pristine/src/sim/simspect_hooks.cc	1969-12-31 16:00:00
+++ hooked/src/sim/simspect_hooks.cc	2026-10-28 15:44:06
@@ -0,0 +1,168 @@
+/*
+ * SimSpect hook: print-only cache/defense event trace (core emitter).
+ * See simspect_hooks.hh. Print-side bookkeeping only; no simulated state.
+ */
+
+#include "sim/simspect_hooks.hh"
+
+#include <map>
+#include <utility>
+#include <vector>
+
+#include "base/cprintf.hh"
+#include "base/trace.hh"
+#include "debug/O3PipeView.hh"
+#include "sim/cur_tick.hh"
+
+namespace gem5 {
+namespace SimSpect {
+
+namespace {
+
+uint64_t g_nextId = 1;
+uint64_t g_nextSq = 1;
+// (squashing seqNum, squash id), in time order
+std::vector<std::pair<uint64_t, uint64_t> > g_squashes;
+std::map<Addr, std::pair<uint64_t, Addr> > g_lineAttr;
+// (struct, line) -> (reserved fill id, seq of the causing access)
+std::map<std::pair<std::string, Addr>, std::pair<uint64_t, uint64_t> >
+    g_pendingFill;
+uint64_t g_tlbSeq = NONE;
+Addr g_tlbPc = NONE;
+
+std::string
+hexOrDash(uint64_t v)
+{
+    if (v == NONE)
+        return "-";
+    return csprintf("0x%x", v);
+}
+
+std::string
+decOrDash(uint64_t v)
+{
+    if (v == NONE)
+        return "-";
+    return csprintf("%d", v);
+}
+
+} // anonymous namespace
+
+bool
+enabled()
+{
+    return TRACING_ON && ::gem5::debug::O3PipeView;
+}
+
+uint64_t
+newId()
+{
+    return g_nextId++;
+}
+
+uint64_t
+emit(const char *st, const char *kind, Addr line, uint64_t seq, Addr pc,
+     Addr victim, uint64_t cause, uint64_t sq, uint64_t id)
+{
+    if (id == NONE)
+        id = newId();
+    DPRINTFR(O3PipeView,
+             "O3PipeView:simspect:%llu:%s:%s:line=%s:seq=%s:pc=%s:"
+             "victim=%s:cause=%s:sq=%s:id=%llu\n",
+             (unsigned long long)curTick(), st, kind,
+             hexOrDash(line), decOrDash(seq), hexOrDash(pc),
+             hexOrDash(victim), decOrDash(cause), decOrDash(sq),
+             (unsigned long long)id);
+    return id;
+}
+
+uint64_t
+noteSquash(uint64_t squashSeq, Addr pc)
+{
+    uint64_t sq = g_nextSq++;
+    g_squashes.push_back(std::make_pair(squashSeq, sq));
+    emit("ROB", "squash", NONE, squashSeq, pc, NONE, NONE, sq);
+    return sq;
+}
+
+uint64_t
+sqForInst(uint64_t seq)
+{
+    if (seq == NONE)
+        return NONE;
+    for (auto it = g_squashes.rbegin(); it != g_squashes.rend(); ++it)
+        if (it->first < seq)
+            return it->second;
+    return NONE;
+}
+
+uint64_t
+sqForSquashSeq(uint64_t squashSeq)
+{
+    for (auto it = g_squashes.rbegin(); it != g_squashes.rend(); ++it)
+        if (it->first == squashSeq)
+            return it->second;
+    return g_squashes.empty() ? NONE : g_squashes.back().second;
+}
+
+void
+setLineAttr(Addr line, uint64_t seq, Addr pc)
+{
+    g_lineAttr[lineOf(line)] = std::make_pair(seq, pc);
+}
+
+bool
+getLineAttr(Addr line, uint64_t &seq, Addr &pc)
+{
+    auto it = g_lineAttr.find(lineOf(line));
+    if (it == g_lineAttr.end()) {
+        seq = NONE;
+        pc = NONE;
+        return false;
+    }
+    seq = it->second.first;
+    pc = it->second.second;
+    return true;
+}
+
+uint64_t
+reserveFill(const std::string &st, Addr line, uint64_t seq)
+{
+    auto key = std::make_pair(st, lineOf(line));
+    auto it = g_pendingFill.find(key);
+    if (it != g_pendingFill.end() && it->second.second == seq)
+        return it->second.first;
+    uint64_t id = newId();
+    g_pendingFill[key] = std::make_pair(id, seq);
+    return id;
+}
+
+uint64_t
+takeFill(const std::string &st, Addr line, uint64_t seq)
+{
+    auto key = std::make_pair(st, lineOf(line));
+    auto it = g_pendingFill.find(key);
+    if (it == g_pendingFill.end())
+        return newId();
+    uint64_t id = it->second.first;
+    bool match = (it->second.second == seq);
+    g_pendingFill.erase(it);
+    return match ? id : newId();
+}
+
+void
+setTlbCtx(uint64_t seq, Addr pc)
+{
+    g_tlbSeq = seq;
+    g_tlbPc = pc;
+}
+
+void
+getTlbCtx(uint64_t &seq, Addr &pc)
+{
+    seq = g_tlbSeq;
+    pc = g_tlbPc;
+}
+
+} // namespace SimSpect
+} // namespace gem5
diff -ruN pristine/src/sim/simspect_hooks.hh hooked/src/sim/simspect_hooks.hh
--- pristine/src/sim/simspect_hooks.hh	1969-12-31 16:00:00
+++ hooked/src/sim/simspect_hooks.hh	2026-10-28 15:44:06
@@ -0,0 +1,63 @@
+/*
+ * SimSpect hook: print-only cache/defense event trace.
+ *
+ * Every event is printed under the existing O3PipeView debug flag as
+ *   O3PipeView:simspect:<tick>:<struct>:<kind>:line=0x<line>:seq=<sn|->:
+ *     pc=0x<pc|->:victim=0x<line|->:cause=<id|->:sq=<id|->:id=<id>
+ * (one physical line). Nothing here changes simulated behavior or timing:
+ * the only state kept is print-side bookkeeping (event ids, squash ids,
+ * per-line attribution), all consulted only when O3PipeView is enabled.
+ * Documented in the SimSpect repo: wiki/design/SIMSPECT_HOOKS.md.
+ */
+
+#ifndef __SIM_SIMSPECT_HOOKS_HH__
+#define __SIM_SIMSPECT_HOOKS_HH__
+
+#include <cstdint>
+#include <string>
+
+#include "base/types.hh"
+
+namespace gem5 {
+namespace SimSpect {
+
+static const uint64_t NONE = ~0ULL;
+
+/** SimSpect hook: true iff O3PipeView tracing is on (all hooks gate on it). */
+bool enabled();
+
+/** Physical line address (64B lines in every SimSpect build). */
+inline Addr lineOf(Addr a) { return a & ~Addr(63); }
+
+/** Fresh unique event id. */
+uint64_t newId();
+
+/** Print one event line; returns its id. NONE fields print as '-'. */
+uint64_t emit(const char *st, const char *kind, Addr line, uint64_t seq,
+              Addr pc, Addr victim, uint64_t cause, uint64_t sq,
+              uint64_t id = NONE);
+
+/** Core squash: emits ROB:squash and returns the new squash id. */
+uint64_t noteSquash(uint64_t squashSeq, Addr pc);
+/** Latest squash whose squashing seqNum < seq (the squash covering seq). */
+uint64_t sqForInst(uint64_t seq);
+/** Latest squash whose squashing seqNum == squashSeq (else latest). */
+uint64_t sqForSquashSeq(uint64_t squashSeq);
+
+/** Per-line attribution: most recent instruction that caused activity. */
+void setLineAttr(Addr line, uint64_t seq, Addr pc);
+bool getLineAttr(Addr line, uint64_t &seq, Addr &pc);
+
+/** Evict->fill link: reserve the id the incoming fill of `line` in `st`
+ *  will carry (cause= on the evict), and consume it at the fill. */
+uint64_t reserveFill(const std::string &st, Addr line, uint64_t seq);
+uint64_t takeFill(const std::string &st, Addr line, uint64_t seq);
+
+/** TLB attribution context (set by TLB::translate before lookup/insert). */
+void setTlbCtx(uint64_t seq, Addr pc);
+void getTlbCtx(uint64_t &seq, Addr &pc);
+
+} // namespace SimSpect
+} // namespace gem5
+
+#endif // __SIM_SIMSPECT_HOOKS_HH__
