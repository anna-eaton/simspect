+// SimSpect hook (v2): closed-vocabulary request kind of a packet.
+const char *
+simspectReqKind(const PacketPtr pkt)
+{
+    if (!pkt || !pkt->req)
+        return "-";
+    if (pkt->isWriteback() || pkt->isEviction())
+        return "wb";
+    if (pkt->req->isPrefetch())
+        return "pf";
+    if (pkt->req->isInstFetch())
+        return "ifetch";
+    if (pkt->isWrite() || pkt->isUpgrade())
+        return "st";
+    if (pkt->isRead())
+        return "ld";
+    return "-";
+}
+
+// SimSpect hook (v2): request context fields (addr, size, req, SpecLFB's
+// own USL / hit-USL request flags, the native command).
+SimSpect::Kv
+simspectPktKv(const PacketPtr pkt)
+{
+    SimSpect::Kv kv;
+    if (!pkt)
+        return kv;
+    kv.hex("addr", pkt->getAddr()).dec("size", pkt->getSize())
+      .str("req", simspectReqKind(pkt)).str("msg", pkt->cmdString());
+    if (pkt->req)
+        kv.flag("usl", pkt->req->isUSL()).flag("hitusl", pkt->req->isHit_USL());
+    return kv;
+}
+
