+// SimSpect hook (v2): SpecLFB's per-load unsafe decision, printed where the
+// LSQ tags the request at translation (lsq.cc SingleDataRequest /
+// SplitDataRequest::initiateTranslation). unsafe = isUnsafe() = (cusl|musl)
+// & reallyunsafe; lqhead = the load is the load-queue head (the entry
+// LSQUnit::updateSafeState skips); requsl = the request's USL flag after
+// tagging (for a split load only the main request is tagged natively).
+void
+simspectUnsafeEv(const DynInstPtr &inst, LSQUnit &port, bool split,
+                 bool reqUsl, Addr vaddr, unsigned size)
+{
+    if (!SimSpect::enabled() || inst->isStore())
+        return;
+    bool lqhead = port.loadQueue.size() > 0 &&
+                  port.loadQueue.front().instruction() == inst;
+    SimSpect::emit("LSQ", "unsafe", SimSpect::NONE, inst->seqNum,
+                   inst->pcState().instAddr(), SimSpect::NONE,
+                   SimSpect::NONE, SimSpect::NONE, SimSpect::NONE,
+                   SimSpect::Kv().flag("unsafe", inst->isUnsafe())
+                     .flag("cusl", inst->isCUSL())
+                     .flag("musl", inst->ismUSL())
+                     .flag("prevnounsafe", inst->isPrevNoUnsafe())
+                     .flag("reallyunsafe", inst->isreallyUnsafe())
+                     .flag("prevbrsres", inst->isPrevBrsResolved())
+                     .flag("lqhead", lqhead)
+                     .flag("split", split)
+                     .flag("requsl", reqUsl)
+                     .hex("vaddr", vaddr).dec("size", size)
+                     .str("req", "ld"));
+}
+} // anonymous namespace
+} // namespace o3
+} // namespace gem5
 
