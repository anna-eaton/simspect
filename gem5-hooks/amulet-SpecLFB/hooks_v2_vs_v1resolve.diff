+// SimSpect hook (v2): a SpecLFB per-load safety flag changed (f = the flag,
+// v = its new value, by = which walk changed it: lsq = LSQUnit::
+// updateSafeState, rob = ROB::updateSafeState).
+inline void
+simspectUslFlag(const DynInstPtr &inst, const char *f, bool v, const char *by)
+{
+    if (!SimSpect::enabled())
+        return;
+    SimSpect::emit("LSQ", "usl_flag", SimSpect::NONE, inst->seqNum,
+                   inst->pcState().instAddr(), SimSpect::NONE,
+                   SimSpect::NONE, SimSpect::NONE, SimSpect::NONE,
+                   SimSpect::Kv().str("f", f).flag("v", v).str("by", by));
+}
+// SimSpect hook (v2): an LSQ event for a load (issue / stlf / data).
+inline void
+simspectLsqEv(const char *kind, const DynInstPtr &inst, Addr paddr,
+              uint64_t size, SimSpect::Kv kv)
+{
+    if (!SimSpect::enabled())
+        return;
+    SimSpect::Kv k2;
+    k2.hex("addr", paddr).dec("size", size).raw(kv.s);
+    SimSpect::emit("LSQ", kind,
+                   paddr == SimSpect::NONE ? SimSpect::NONE
+                                           : SimSpect::lineOf(paddr),
+                   inst->seqNum, inst->pcState().instAddr(), SimSpect::NONE,
+                   SimSpect::NONE, SimSpect::NONE, SimSpect::NONE, k2);
+}
