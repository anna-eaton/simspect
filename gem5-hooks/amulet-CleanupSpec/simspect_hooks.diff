diff -ruN pristine/src/mem/ruby/slicc_interface/SimSpectRubyHooks.cc hooked/src/mem/ruby/slicc_interface/SimSpectRubyHooks.cc
--- pristine/src/mem/ruby/slicc_interface/SimSpectRubyHooks.cc	1969-12-31 16:00:00
+++ hooked/src/mem/ruby/slicc_interface/SimSpectRubyHooks.cc	2026-10-28 15:53:09
@@ -0,0 +1,362 @@
+/*
+ * SimSpect hook: Ruby-side helpers for the print-only cache event trace.
+ * See SimSpectRubyHooks.hh. No simulated state is read for decisions or
+ * written; everything here only decides what to PRINT.
+ *
+ * Native event -> SimSpect kind (decided at the CacheMemory call, from the
+ * SLICC event of the enclosing transition):
+ *   CacheMemory::allocate   : *ROLLBACK* event -> cleanup_restore, else fill
+ *   CacheMemory::deallocate : *Replacement* event -> evict;
+ *                             Inv_CLEANUP / Cleanup_Invalidate(_clean)
+ *                               -> cleanup_inv; anything else -> inv
+ *   CacheMemory::setMRU     : repl_touch
+ *   TBETable alloc/free     : MSHR (L1) / L2MSHR / DIRTBE buf_fill/buf_release
+ * Transition-level (endTransition, no tag change in that transition):
+ *   coh  : line's last stable state -> new stable state, both "present"
+ *          (permission Read_Only/Read_Write/Maybe_Stale), no alloc/dealloc
+ *   CleanupSpec decisions (names never occur in other protocols):
+ *     Skip_ROLLBACK, Skip_Inflight_Cleanup            -> cleanup_skip
+ *     Load_ROLLBACK on a present line (no allocate)   -> cleanup_skip
+ *     Inv_CLEANUP on NP/I/M (stable, no deallocate)   -> cleanup_skip
+ *     Inflight_CLEANUP_reqs  NP -> cleanup_drop ; ->NP (from M_I/I) -> skip
+ *     Drop_Load_Cleanup_Inflight                      -> cleanup_drop
+ *     L2 SendAck_Cleanup_Invalidate in NP             -> cleanup_skip
+ */
+
+#include "mem/ruby/slicc_interface/SimSpectRubyHooks.hh"
+
+#include <map>
+#include <tuple>
+#include <vector>
+
+#include "mem/packet.hh"
+#include "mem/protocol/RubyRequestType.hh"
+#include "mem/request.hh"
+#include "mem/ruby/slicc_interface/RubyRequest.hh"
+#include "mem/ruby/structures/CacheMemory.hh"
+
+namespace SimSpect {
+
+MsgCtx g_msg;
+
+namespace {
+
+struct TransCtx
+{
+    std::string machine;
+    int version;
+    std::string event;
+    std::string state;
+    std::string statePerm;
+    Addr addr;
+    bool allocated;
+    bool deallocated;
+};
+
+std::vector<TransCtx> g_trans;
+std::map<const CacheMemory *, std::string> g_structName;
+typedef std::tuple<std::string, int, Addr> LineKey;
+std::map<LineKey, std::string> g_resident;      // which L1 holds the line
+std::map<LineKey, std::pair<std::string, bool> > g_lastStable;
+
+bool
+isPresentPerm(const std::string &p)
+{
+    return p == "Read_Only" || p == "Read_Write" || p == "Maybe_Stale";
+}
+
+bool
+contains(const std::string &s, const char *sub)
+{
+    return s.find(sub) != std::string::npos;
+}
+
+const std::string &
+structOf(const CacheMemory *cm)
+{
+    auto it = g_structName.find(cm);
+    if (it != g_structName.end())
+        return it->second;
+    std::string n = cm->name();
+    std::string s;
+    if (contains(n, "L1Dcache"))
+        s = "L1D";
+    else if (contains(n, "L1Icache"))
+        s = "L1I";
+    else if (contains(n, "L2cache"))
+        s = "L2";
+    else {
+        size_t dot = n.rfind('.');
+        s = (dot == std::string::npos) ? n : n.substr(dot + 1);
+    }
+    return g_structName[cm] = s;
+}
+
+void
+attr(uint64_t &seq, Addr &pc)
+{
+    seq = NONE;
+    pc = NONE;
+    if (!g_msg.valid)
+        return;
+    if (g_msg.isCpu) {
+        seq = g_msg.seq;
+        pc = g_msg.pc;
+    } else {
+        getLineAttr(g_msg.line, seq, pc);
+    }
+}
+
+TransCtx *
+cur()
+{
+    return g_trans.empty() ? nullptr : &g_trans.back();
+}
+
+LineKey
+keyFor(const TransCtx *t, Addr a)
+{
+    return LineKey(t ? t->machine : std::string("?"), t ? t->version : -1,
+                   lineOf(a));
+}
+
+std::string
+machineStruct(const TransCtx *t)
+{
+    if (t->machine == "L1Cache") {
+        auto it = g_resident.find(keyFor(t, t->addr));
+        if (it != g_resident.end())
+            return it->second;
+        return g_msg.valid && g_msg.isIfetch ? "L1I" : "L1D";
+    }
+    if (t->machine == "L2Cache")
+        return "L2";
+    if (t->machine == "Directory")
+        return "DIR";
+    return t->machine;
+}
+
+} // anonymous namespace
+
+void
+noteRubyRequest(const RubyRequest *m)
+{
+    MsgCtx c;
+    c.valid = true;
+    c.isCpu = true;
+    c.line = lineOf(m->m_LineAddress);
+    c.isIfetch = (m->m_Type == RubyRequestType_IFETCH);
+    c.pc = m->m_ProgramCounter ? m->m_ProgramCounter : NONE;
+    if (m->m_pkt && m->m_pkt->req && m->m_pkt->req->hasInstSeqNum())
+        c.seq = m->m_pkt->req->getReqInstSeqNum();
+    g_msg = c;
+}
+
+void
+noteMsgAddr(Addr a)
+{
+    MsgCtx c;
+    c.valid = true;
+    c.line = lineOf(a);
+    g_msg = c;
+}
+
+void
+beginTransition(const char *machine, int version, const std::string &event,
+                const std::string &state, const std::string &statePerm,
+                Addr addr)
+{
+    TransCtx t;
+    t.machine = machine;
+    t.version = version;
+    t.event = event;
+    t.state = state;
+    t.statePerm = statePerm;
+    t.addr = addr;
+    t.allocated = false;
+    t.deallocated = false;
+    g_trans.push_back(t);
+    LineKey k = keyFor(&t, addr);
+    if (statePerm != "Busy" && g_lastStable.find(k) == g_lastStable.end())
+        g_lastStable[k] = std::make_pair(state, isPresentPerm(statePerm));
+}
+
+void
+endTransition(bool valid, const std::string &nextState,
+              const std::string &nextPerm)
+{
+    if (g_trans.empty())
+        return;
+    TransCtx t = g_trans.back();
+    g_trans.pop_back();
+    if (!valid)
+        return;
+
+    uint64_t seq, pc;
+    attr(seq, pc);
+    Addr line = lineOf(t.addr);
+    const std::string &ev = t.event;
+    std::string st = machineStruct(&t);
+    const char *kind = nullptr;
+
+    // CleanupSpec cleanup decisions with no tag change in this transition.
+    if (ev == "Skip_ROLLBACK" || ev == "Skip_Inflight_Cleanup") {
+        kind = "cleanup_skip";
+    } else if (ev == "Load_ROLLBACK" && !t.allocated &&
+               isPresentPerm(t.statePerm)) {
+        kind = "cleanup_skip";
+    } else if (ev == "Inv_CLEANUP" && !t.deallocated &&
+               t.statePerm != "Busy") {
+        kind = "cleanup_skip";
+    } else if (ev == "Inflight_CLEANUP_reqs") {
+        if (t.state == "NP")
+            kind = "cleanup_drop";
+        else if (nextState == "NP")
+            kind = "cleanup_skip";
+    } else if (ev == "Drop_Load_Cleanup_Inflight") {
+        kind = "cleanup_drop";
+    } else if (ev == "SendAck_Cleanup_Invalidate" && t.state == "NP") {
+        kind = "cleanup_skip";
+    }
+    if (kind)
+        emit(st.c_str(), kind, line, seq, pc, NONE, NONE, sqForInst(seq));
+
+    // coh: stable->stable state change of a present line, no tag change.
+    if (nextPerm != "Busy") {
+        LineKey k = keyFor(&t, t.addr);
+        bool nowPresent = isPresentPerm(nextPerm);
+        auto it = g_lastStable.find(k);
+        if (it != g_lastStable.end() && it->second.first != nextState &&
+            it->second.second && nowPresent && !t.allocated &&
+            !t.deallocated) {
+            emit(st.c_str(), "coh", line, seq, pc, NONE, NONE, NONE);
+        }
+        g_lastStable[k] = std::make_pair(nextState, nowPresent);
+    }
+}
+
+void
+onCacheAllocate(const CacheMemory *cm, Addr a)
+{
+    if (!enabled())
+        return;
+    TransCtx *t = cur();
+    const std::string &st = structOf(cm);
+    uint64_t seq, pc;
+    attr(seq, pc);
+    Addr line = lineOf(a);
+    if (t && contains(t->event, "ROLLBACK")) {
+        emit(st.c_str(), "cleanup_restore", line, seq, pc, NONE, NONE,
+             sqForInst(seq));
+    } else {
+        uint64_t id = takeFill(st, line, seq);
+        emit(st.c_str(), "fill", line, seq, pc, NONE, NONE, NONE, id);
+    }
+    if (t) {
+        t->allocated = true;
+        g_resident[keyFor(t, line)] = st;
+    }
+}
+
+void
+onCacheDeallocate(const CacheMemory *cm, Addr a)
+{
+    if (!enabled())
+        return;
+    TransCtx *t = cur();
+    const std::string &st = structOf(cm);
+    uint64_t seq, pc;
+    attr(seq, pc);
+    Addr line = lineOf(a);
+    std::string ev = t ? t->event : std::string();
+    if (contains(ev, "Replacement")) {
+        Addr incoming = (g_msg.valid && g_msg.line != line) ? g_msg.line
+                                                             : line;
+        uint64_t cause = (incoming != line) ? reserveFill(st, incoming, seq)
+                                            : NONE;
+        emit(st.c_str(), "evict", incoming, seq, pc, line, cause, NONE);
+        if (seq != NONE)
+            setLineAttr(line, seq, pc);
+    } else if (ev == "Inv_CLEANUP" || ev == "Cleanup_Invalidate" ||
+               ev == "Cleanup_Invalidate_clean") {
+        emit(st.c_str(), "cleanup_inv", line, seq, pc, NONE, NONE,
+             sqForInst(seq));
+    } else {
+        emit(st.c_str(), "inv", line, seq, pc, NONE, NONE, NONE);
+    }
+    if (t) {
+        t->deallocated = true;
+        g_resident.erase(keyFor(t, line));
+    }
+}
+
+void
+onCacheTouch(const CacheMemory *cm, Addr a)
+{
+    if (!enabled())
+        return;
+    uint64_t seq, pc;
+    attr(seq, pc);
+    emit(structOf(cm).c_str(), "repl_touch", lineOf(a), seq, pc, NONE, NONE,
+         NONE);
+}
+
+namespace {
+
+const char *
+tbeStruct(const TransCtx *t)
+{
+    if (!t) return "TBE";
+    if (t->machine == "L1Cache") return "MSHR";
+    if (t->machine == "L2Cache") return "L2MSHR";
+    if (t->machine == "Directory") return "DIRTBE";
+    return "TBE";
+}
+
+// live TBE entries: (machine, version, line) -> (seq, pc) from allocation
+std::map<LineKey, std::pair<uint64_t, Addr> > g_tbe;
+
+} // anonymous namespace
+
+void
+onTBEAllocate(Addr a)
+{
+    if (!enabled())
+        return;
+    Addr line = lineOf(a);
+    if (g_msg.valid) {
+        if (g_msg.isCpu) {
+            setLineAttr(line, g_msg.seq, g_msg.pc);
+        } else if (g_msg.line != line) {
+            uint64_t seq, pc;
+            if (getLineAttr(g_msg.line, seq, pc))
+                setLineAttr(line, seq, pc);
+        }
+    }
+    TransCtx *t = cur();
+    uint64_t seq, pc;
+    attr(seq, pc);
+    if (seq == NONE)
+        getLineAttr(line, seq, pc);
+    g_tbe[keyFor(t, line)] = std::make_pair(seq, pc);
+    emit(tbeStruct(t), "buf_fill", line, seq, pc, NONE, NONE, NONE);
+}
+
+void
+onTBEDeallocate(Addr a)
+{
+    if (!enabled())
+        return;
+    TransCtx *t = cur();
+    Addr line = lineOf(a);
+    uint64_t seq = NONE, pc = NONE;
+    auto it = g_tbe.find(keyFor(t, line));
+    if (it != g_tbe.end()) {
+        seq = it->second.first;
+        pc = it->second.second;
+        g_tbe.erase(it);
+    }
+    emit(tbeStruct(t), "buf_release", line, seq, pc, NONE, NONE, NONE);
+}
+
+} // namespace SimSpect
diff -ruN pristine/src/mem/ruby/slicc_interface/SimSpectRubyHooks.hh hooked/src/mem/ruby/slicc_interface/SimSpectRubyHooks.hh
--- pristine/src/mem/ruby/slicc_interface/SimSpectRubyHooks.hh	1969-12-31 16:00:00
+++ hooked/src/mem/ruby/slicc_interface/SimSpectRubyHooks.hh	2026-10-28 15:53:09
@@ -0,0 +1,87 @@
+/*
+ * SimSpect hook: Ruby-side helpers for the print-only cache event trace.
+ *
+ * Called from (a) SLICC-generated code (PeekStatementAST: noteMsg on every
+ * peeked in_msg; StateMachine doTransition: begin/endTransition around every
+ * transition), (b) CacheMemory allocate/deallocate/setMRU, (c) TBETable
+ * allocate. Everything is print-side bookkeeping, gated on O3PipeView.
+ * See wiki/design/SIMSPECT_HOOKS.md in the SimSpect repo.
+ */
+
+#ifndef __MEM_RUBY_SLICC_INTERFACE_SIMSPECTRUBYHOOKS_HH__
+#define __MEM_RUBY_SLICC_INTERFACE_SIMSPECTRUBYHOOKS_HH__
+
+#include <string>
+
+#include "base/types.hh"
+#include "sim/simspect_hooks.hh"
+
+class RubyRequest;
+class CacheMemory;
+
+namespace SimSpect {
+
+/** The message the current controller is processing (set at each peek). */
+struct MsgCtx
+{
+    bool valid;
+    Addr line;
+    bool isCpu;     // a RubyRequest from the Sequencer (exact seq/pc)
+    bool isIfetch;
+    uint64_t seq;
+    Addr pc;
+    MsgCtx() : valid(false), line(0), isCpu(false), isIfetch(false),
+               seq(NONE), pc(NONE) {}
+};
+extern MsgCtx g_msg;
+
+void noteRubyRequest(const RubyRequest *m);
+void noteMsgAddr(Addr a);
+
+template <class T>
+auto noteMsgImpl(const T *m, int) -> decltype((void)m->m_addr, void())
+{
+    noteMsgAddr(m->m_addr);
+}
+
+template <class T>
+void noteMsgImpl(const T *, long)
+{
+    g_msg = MsgCtx();
+}
+
+/** SimSpect hook: generic peeked message (protocol msgs carry m_addr). */
+template <class T>
+inline void noteMsg(const T *m)
+{
+    if (enabled())
+        noteMsgImpl(m, 0);
+}
+
+/** SimSpect hook: a Sequencer RubyRequest (carries the inst seqNum). */
+inline void noteMsg(const RubyRequest *m)
+{
+    if (enabled())
+        noteRubyRequest(m);
+}
+
+/** SimSpect hook: wraps every SLICC transition (doTransition). */
+void beginTransition(const char *machine, int version,
+                     const std::string &event, const std::string &state,
+                     const std::string &statePerm, Addr addr);
+void endTransition(bool valid, const std::string &nextState,
+                   const std::string &nextPerm);
+
+/** SimSpect hook: CacheMemory tag changes / replacement-state updates. */
+void onCacheAllocate(const CacheMemory *cm, Addr a);
+void onCacheDeallocate(const CacheMemory *cm, Addr a);
+void onCacheTouch(const CacheMemory *cm, Addr a);
+
+/** SimSpect hook: TBE (Ruby MSHR) alloc/free -> MSHR/L2MSHR/DIRTBE
+ *  buf_fill/buf_release; allocation also records per-line attribution. */
+void onTBEAllocate(Addr a);
+void onTBEDeallocate(Addr a);
+
+} // namespace SimSpect
+
+#endif // __MEM_RUBY_SLICC_INTERFACE_SIMSPECTRUBYHOOKS_HH__
