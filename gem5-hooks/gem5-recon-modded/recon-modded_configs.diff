 from common.Caches import *
 from common.cpu2000 import *
 
+def _ann_to_addr(entry, base, key_candidates):
+    """Resolve a single annotation field to an absolute PC.
+
+    key_candidates is an ordered list of (key, is_relative) tuples. The first
+    key present in `entry` wins; its value is interpreted as hex if it is a
+    string, else as an int. If the key is marked relative, `base` is added.
+    Returns None if no key matched.
+    """
+    for key, is_relative in key_candidates:
+        if key not in entry:
+            continue
+        raw = entry[key]
+        if isinstance(raw, str):
+            val = int(raw, 0)
+        else:
+            val = int(raw)
+        return val + (base if is_relative else 0)
+    return None
+
+
+def load_branch_annotations(path, base):
+    """Parse a JSON annotation file and return
+    (branch_pcs, forced_targets, resolve_stall_cycles).
+
+    Supports both the existing STT_3-style format (relative x86_pc_offset[_hex]
+    plus a user-supplied base) and an absolute-address extension
+    (branch_pc_addr[_hex] / btb_forced_target_addr[_hex]).
+
+    Per-entry "resolve_stall_cycles" (int) defers the broadcast of that
+    branch's resolution by N cycles. Missing values default to 0.
+    """
+    with open(path, 'r') as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or 'annotations' not in data:
+        fatal("branch annotation file %s has no 'annotations' array" % path)
+
+    branch_pcs = []
+    forced_targets = []
+    resolve_stall_cycles = []
+
+    branch_keys = [
+        ('branch_pc_addr_hex', False),
+        ('branch_pc_addr', False),
+        ('x86_branch_offset_hex', True),
+        ('x86_branch_offset', True),
+        ('x86_pc_offset_hex', True),
+        ('x86_pc_offset', True),
+    ]
+    target_keys = [
+        ('btb_forced_target_addr_hex', False),
+        ('btb_forced_target_addr', False),
+        ('btb_forced_target_x86_offset_hex', True),
+        ('btb_forced_target_x86_offset', True),
+    ]
+
+    # Stall-only modes (skip BTB-force, keep resolution-broadcast stall):
+    #   - correctly_not_taken:   BTB defaults to fall-through, which IS the
+    #                            architecturally correct prediction.
+    #   - mispredict_not_taken:  BTB defaults to fall-through. The arch
+    #                            outcome is taken — so this is naturally a
+    #                            misprediction, no force needed. Forcing
+    #                            BTB to a non-fall-through target risks
+    #                            decode-stage static-target correction
+    #                            (gem5 catches the mismatch between the
+    #                            forced target and the branch instruction's
+    #                            encoded target, squashing speculation
+    #                            before the deferred-broadcast deadline).
+    # mispredict_taken DOES require a forced target (the taken direction is
+    # not the natural BTB default), but isn't currently exercised.
+    NO_FORCE = 0
+    STALL_ONLY_MODES = {'correctly_not_taken', 'mispredict_not_taken'}
+
+    for entry in data['annotations']:
+        branch_pc = _ann_to_addr(entry, base, branch_keys)
+        target_pc = _ann_to_addr(entry, base, target_keys)
+        if branch_pc is None:
+            warn("annotation missing branch PC, skipping: %r" % entry)
+            continue
+        mode = entry.get('mode', '')
+        if mode in STALL_ONLY_MODES:
+            target_pc = NO_FORCE
+        elif target_pc is None:
+            warn("annotation at %#x missing forced target, skipping" %
+                 branch_pc)
+            continue
+        branch_pcs.append(branch_pc)
+        forced_targets.append(target_pc)
+        stall = entry.get('resolve_stall_cycles', 0)
+        try:
+            resolve_stall_cycles.append(int(stall))
+        except (TypeError, ValueError):
+            warn("annotation at %#x has non-integer resolve_stall_cycles=%r, "
+                 "treating as 0" % (branch_pc, stall))
+            resolve_stall_cycles.append(0)
+
+    return branch_pcs, forced_targets, resolve_stall_cycles
+
+
